# Obsidian local-machine UI state (causes noisy diffs, not real content)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/

# Claudian local session history (local chat state, not vault content)
.claudian/sessions/

# Installed community plugin binaries (reinstalled via Obsidian, not vault content)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/data.json

# graphify: regenerable per-file extraction cache, not meaningful to version control
graphify-out/cache/
