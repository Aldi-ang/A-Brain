# Obsidian local-machine UI state (causes noisy diffs, not real content)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/

# Claudian local session history (local chat state, not vault content)
.claudian/sessions/

# Installed community plugin binaries (reinstalled via Obsidian, not vault content)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/data.json

# graphify: regenerable per-file extraction cache, not meaningful to version control
graphify-out/cache/

# Archive/awesome-n8n-templates/ was ignored here until 2026-08-23 as "a cloned repo someone
# dropped in the archive - not ours to track". Aldi reversed that deliberately: "make sure that we
# saved this github even when the owner delete all of this on purpose". Tracking it IS the point --
# an ignored clone dies with the upstream repo. Its own .git was removed so these are plain files.

# per-session state for the lessons flush hook; junk after the session ends
runs/.lessons-state/
